modules = ["nodejs-24", "python-base-3.13", "postgresql-16"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[nix]
channel = "stable-25_05"

[userenv]

[userenv.shared]
EMAIL_FROM_DOMAIN = "notifications.example.com"
EMAIL_PLATFORM_NAME = "Daybook"
EMAIL_TIER1_DAILY_LIMIT = "200"
EMAIL_TIER1_MONTHLY_UPGRADE_THRESHOLD = "1000"

[objectStorage]
defaultBucketID = "replit-objstore-8dda2e7d-40f3-4539-932f-d03b3d8bc981"
